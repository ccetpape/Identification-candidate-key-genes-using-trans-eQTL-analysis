```{r}
############################################################
# 5. PRIMARY MR: RANDOM-EFFECTS IVW
############################################################

# Voor elk gen uitvoeren

primary_results <- lapply(
  split(harmonised_data, harmonised_data$exposure),
  function(d) {

    # Alleen SNPs die voor MR behouden zijn
    d <- d %>%
      filter(mr_keep)

    # Geen SNPs over
    if (nrow(d) == 0) {
      return(NULL)
    }

    # Eén SNP → Wald ratio
    if (nrow(d) == 1) {

      res <- mr(
        d,
        method_list = "mr_wald_ratio"
      )

    # ≥2 SNPs → IVW random effects
    } else {

      res <- mr(
        d,
        method_list = "mr_ivw_mre"
      )
    }

    res
  }
) %>%
  bind_rows()
```
