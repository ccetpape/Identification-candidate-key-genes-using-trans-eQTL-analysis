```{r}
############################################################
# 18. CONFINDENCE CLASSIFICATION
############################################################

final_results <- final_results %>%
  mutate(
    # direction primairy MR-effect (b) versus pIVW (beta_pIVW)
    direction_consistent = !is.na(b) &
      !is.na(beta_pIVW) &
      sign(b) == sign(beta_pIVW) &
      b != 0 &
      beta_pIVW != 0,

    core_criteria =
      !is.na(nsnp) &
      nsnp >= 3 &
      !is.na(pval) &
      pval < 0.05 &
      !is.na(egger_p) &
      egger_p >= 0.05 &
      !is.na(loo_no_reversal) &
      loo_no_reversal == TRUE &
      direction_consistent == TRUE &
      !is.na(FDR_significant) &
      FDR_significant == TRUE,

    # High confidence: no significant heterogeneity
    high = as.integer(
      core_criteria &
      !is.na(heterogeneity_p) &
      heterogeneity_p >= 0.05
    ),

    # Moderate confidence: significant heterogeneity
    moderate = as.integer(
      core_criteria &
      !is.na(heterogeneity_p) &
      heterogeneity_p < 0.05
    ),

    # Low confidence: left over genes
    low = as.integer(
      high == 0 & moderate == 0
    )
  ) %>%
  select(-direction_consistent, -core_criteria)
```
