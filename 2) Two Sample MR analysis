```{r}
############################################################
# 9. PENALIZED IVW (pIVW)
############################################################

pivw_results <- lapply(
  split(harmonised_data, harmonised_data$exposure),
  function(d) {
    
    # Alleen SNPs die door harmonisatie zijn behouden
    d <- d %>%
      filter(mr_keep == TRUE)
    
    # Geen SNPs over
    if (nrow(d) == 0) {
      return(NULL)
    }
    
    # Aantal unieke SNPs
    n_snps <- n_distinct(d$SNP)
    
    # pIVW alleen bij minimaal 3 onafhankelijke SNPs
    if (n_snps < 3) {
      return(NULL)
    }
    
    # Alleen complete SNP-informatie gebruiken
    d <- d %>%
      filter(
        !is.na(beta.outcome),
        !is.na(beta.exposure),
        !is.na(se.outcome),
        !is.na(se.exposure),
        se.outcome > 0,
        se.exposure > 0
      )
    
    # Opnieuw aantal SNPs controleren
    n_snps <- n_distinct(d$SNP)
    
    if (n_snps < 3) {
      return(NULL)
    }
    
    # Data voor pIVW
    pivw_data <- d %>%
      select(
        beta.outcome,
        beta.exposure,
        se.outcome,
        se.exposure
      )
    
    # pIVW
    fit <- mr.pivw(
      data = pivw_data,
      lambda = 1,
      plei = TRUE
    )
    
    # Resultaat
    data.frame(
      exposure = d$exposure[1],
      id.exposure = d$id.exposure[1],
      outcome = d$outcome[1],
      id.outcome = d$id.outcome[1],
      nsnp = n_snps,
      b = fit$beta.hat,
      se = fit$beta.se,
      p = fit$`pval (Normal)`
    )
  }
) %>%
  bind_rows()
```

