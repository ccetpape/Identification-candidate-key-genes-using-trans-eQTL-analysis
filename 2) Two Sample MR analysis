```{r}
############################################################
# 1. CALCULATE F-STATISTIC PER SNP
############################################################

sum_eqtl <- sum_eqtl %>%
  mutate(
    F_stat = (beta / standard_error)^2
  )

# show weak instruments
sum_eqtl %>%
  filter(F_stat < 10) %>%
  arrange(F_stat)
```
```{r}
############################################################
# 2. SUMMARY INSTRUMENTSTRENTH PER GENE
############################################################
instrument_summary <- sum_eqtl %>%
  group_by(gene_name) %>%
  summarise(
    phenotype = first(phenotype),
    n_SNP = n(),
    min_F = min(F_stat, na.rm = TRUE),
    median_F = median(F_stat, na.rm = TRUE),
    mean_F = mean(F_stat, na.rm = TRUE),
    max_F = max(F_stat, na.rm = TRUE),
    n_weak = sum(F_stat < 10, na.rm = TRUE),
    .groups = "drop"
  )

instrument_summary
```

