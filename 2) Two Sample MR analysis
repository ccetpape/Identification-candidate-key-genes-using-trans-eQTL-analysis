```{r}
############################################################
# 18. CONFINDENCE CLASSIFICATION
############################################################

final_results <- final_results %>%
  mutate(
    # Richting primaire MR-effectschatting versus pIVW
    direction_consistent = !is.na(b) &
      !is.na(beta_pIVW) &
      sign(b) == sign(beta_pIVW) &
      b != 0 &
      beta_pIVW != 0,

    core_criteria =
      !is.na(n_SNP) &
      n_SNP >= 2 &
      !is.na(pval) &
      pval < 0.05 &
      !is.na(egger_p) &
      egger_p >= 0.05 &
      !is.na(loo_no_reversal) &
      loo_no_reversal == TRUE &
      direction_consistent == TRUE,

    # High confidence: no significant heterogeneity
    high = as.integer(
      core_criteria &
      !is.na(heterogeneity_p) &
      heterogeneity_p >= 0.05
    ),

    # Moderate confidence: significant heterogeneity
    moderate = as.integer(
      core_criteria &
      !is.na(heterogeneity_p) &
      heterogeneity_p < 0.05
    ),

    # Low confidence: left over genes
    low = as.integer(
      high == 0 & moderate == 0
    )
  ) %>%
  select(-direction_consistent, -core_criteria)
```
```{r}
colSums(final_results[, c("high", "moderate", "low")] == 1, na.rm = TRUE)

# nr exposures per category
final_results %>%
  summarise(
    n_high = sum(high == 1, na.rm = TRUE),
    n_moderate = sum(moderate == 1, na.rm = TRUE),
    n_low = sum(low == 1, na.rm = TRUE)
  )
