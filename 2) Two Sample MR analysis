# 16. CALCULATE LOO PER EXPOSURE AND ADD TO FINAL RESULTS 
############################################################

loo_summary <- loo_results %>%
  left_join(
    final_results %>%
      select(id.exposure, beta_pIVW),
    by = "id.exposure"
  ) %>%
  filter(SNP != "All") %>%
  group_by(id.exposure) %>%
  summarise(
    loo_no_reversal = if (
      is.na(first(beta_pIVW)) ||
      first(beta_pIVW) == 0 ||
      anyNA(b) ||
      any(b == 0)
    ) {
      FALSE
    } else {
      all(sign(b) == sign(first(beta_pIVW)))
    },
    n_loo = n(),
    .groups = "drop"
  )

final_results <- final_results %>%
  left_join(
    loo_summary %>%
      select(id.exposure, loo_no_reversal, n_loo),
    by = "id.exposure"
  )
